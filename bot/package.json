{
  "name": "motregen-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node --max-old-space-size=192 --max-semi-space-size=4 --expose-gc dist/bot/main.js",
    "dev": "node --max-old-space-size=192 --max-semi-space-size=4 --expose-gc --import tsx main.ts",
    "smoke": "node --max-old-space-size=192 --max-semi-space-size=4 --expose-gc --import tsx smoke.ts",
    "render": "node --max-old-space-size=192 --max-semi-space-size=4 --expose-gc --import tsx smoke.ts --render-only",
    "parity": "tsx parity.ts",
    "soak": "node --max-old-space-size=192 --max-semi-space-size=4 --expose-gc --import tsx soak.ts",
    "soak:upload": "node --expose-gc --import tsx upload-soak.ts",
    "typecheck": "tsc --noEmit",
    "render:constants": "tsx render-constants.ts",
    "prebuild": "pnpm render:constants",
    "pretest": "pnpm --dir ../web synthgen",
    "test": "vitest run",
    "build": "tsc && rustc native-raster.rs -O -o dist/bot/native-raster && rustc native-field-raster.rs -O -o dist/bot/native-field-raster"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "pmtiles": "^4.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
