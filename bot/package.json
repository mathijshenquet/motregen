{
  "name": "motregen-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/bot/main.js",
    "dev": "tsx main.ts",
    "smoke": "tsx smoke.ts",
    "render": "tsx smoke.ts --render-only",
    "parity": "tsx parity.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc && rustc native-raster.rs -O -o dist/bot/native-raster"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.61.1",
    "pmtiles": "^4.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
