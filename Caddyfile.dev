{
	auto_https off
}

:{$MOTREGEN_WEB_PORT:8081} {
	root * {$MOTREGEN_FRONTEND_DIR:web/dist}
	handle_path /data/* {
		reverse_proxy localhost:8080
	}
	handle /telegram/* {
		respond 404
	}
	handle /hit {
		respond 404
	}
	handle {
		import {$MOTREGEN_FRONTEND_DIR:web/dist}/routes.caddy
	}
}

:8080 {
	root * {$MOTREGEN_DATA_DIR:data}

	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
		Accept-Ranges "bytes"
		Document-Policy "js-profiling"
	}
	header /manifest.json Cache-Control "public, max-age=15, stale-while-revalidate=60"
	header /chunks/* Cache-Control "public, max-age=31536000, immutable"
	header /chunks/* -Content-Encoding
	header /sw.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "no-cache"

	handle /prof {
		reverse_proxy {$MOTREGEN_PROF_ORIGIN:127.0.0.1:4331}
	}
	handle /manifest.json {
		file_server
	}
	handle /chunks/* {
		file_server
	}
	respond 404
}
