{
	auto_https off
	admin off
}

:{$MOTREGEN_E2E_DATA_PORT:8392} {
	root * {$MOTREGEN_MOBILE_FIXTURE_DIR:public/perf-mobile}
	header {
		Access-Control-Allow-Origin "*"
		Timing-Allow-Origin "*"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
		Accept-Ranges "bytes"
	}
	@session {
		path /manifest.json
		query s=1
	}
	@shared {
		path /manifest.json
		not query s=1
	}
	header @session Cache-Control "no-store"
	header @shared Cache-Control "public, max-age=15, stale-while-revalidate=60"
	header /chunks/* Cache-Control "public, max-age=31536000, immutable"
	header /basemap/* Cache-Control "public, max-age=31536000, immutable"
	handle /tiles/* {
		rewrite * /tile.pbf
		file_server
	}
	handle {
		file_server
	}
}
