{
	auto_https off
	admin off
}

:{$MOTREGEN_E2E_PORT:4392} {
	log {
		output file {$MOTREGEN_DESKTOP_ACCESS_LOG:/tmp/motregen-desktop-access.jsonl}
		format json
	}
	header Document-Policy "js-profiling"
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	@sessionManifest {
		path /data/manifest.json
		query s=1
	}
	header @sessionManifest {
		Cache-Control "no-store"
		defer
	}
	handle_path /data/* {
		reverse_proxy 127.0.0.1:{$MOTREGEN_E2E_DATA_PORT:8392}
	}
	handle {
		root * {$MOTREGEN_RIG_DIST:dist}
		try_files {path} /index.html
		file_server {
			precompressed gzip
		}
	}
}
