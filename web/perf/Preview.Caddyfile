{
	auto_https off
	admin off
}

:{$MOTREGEN_E2E_PORT:4392} {
	header Document-Policy "js-profiling"
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	header /plaatsen-*.json Cache-Control "public, max-age=31536000, immutable"
	handle /perf-warm-bootstrap {
		header Content-Type "text/html"
		respond "<!doctype html><title>cachevoorbereiding</title>" 200
	}
	handle_path /data/* {
		reverse_proxy 127.0.0.1:{$MOTREGEN_E2E_DATA_PORT:8392}
	}
	handle {
		root * {$MOTREGEN_RIG_DIST:dist}
		file_server {
			precompressed gzip
		}
	}
}
