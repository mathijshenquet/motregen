{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "playwright.mobile.config.ts", "playwright.reference.config.ts", "e2e/mobile-load.rig.ts", "e2e/mobile-probe.ts", "e2e/worker-throttle.ts", "e2e/profiles.ts", "e2e/reference-buienradar.rig.ts", "e2e/reference-probe.ts", "scripts", "src/types"]
}
